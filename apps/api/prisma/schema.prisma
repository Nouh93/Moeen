// منصة مُعين — مخطط قاعدة البيانات (المرحلة 1: MVP)
// Multi-tenant: كل بيانات التاجر مرتبطة بـ storeId — القسم 17.2 من الوثيقة الرئيسية.
// (تفعيل Row-Level Security يُضاف في مرحلة التقوية قبل الإطلاق)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- المستخدمون والتحقق ----------

model User {
  id        String   @id @default(cuid())
  phone     String   @unique // +9677XXXXXXXX
  name      String?
  role      UserRole @default(MERCHANT)
  createdAt DateTime @default(now())
  stores    Store[]
}

enum UserRole {
  MERCHANT
  ADMIN
}

// رموز OTP — القسم 4.1 (واتساب أولاً و SMS احتياطاً؛ في التطوير يُعاد الرمز في الاستجابة)
model OtpCode {
  id         String    @id @default(cuid())
  phone      String
  code       String
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([phone, code])
}

// ---------- التقسيم الإداري اليمني (القسم 23 من الملحق) ----------

model Governorate {
  id        Int        @id @default(autoincrement())
  code      String     @unique
  nameAr    String
  districts     District[]
  stores        Store[]
  orders        Order[]
  shippingRates ShippingRate[]
}

model District {
  id            Int         @id @default(autoincrement())
  nameAr        String
  governorate   Governorate @relation(fields: [governorateId], references: [id])
  governorateId Int
  orders        Order[]

  @@unique([governorateId, nameAr])
}

// ---------- المتجر (المستأجر / Tenant) ----------

model Store {
  id            String       @id @default(cuid())
  slug          String       @unique
  name          String
  description   String?
  logoUrl       String?
  whatsapp      String?
  currency      Currency     @default(YER_SANAA)
  status        StoreStatus  @default(ACTIVE)
  plan          Plan         @default(FREE)
  // ---- الفوترة والاشتراك (القسم 24 بالملحق) ----
  // كود قصير يدخل في مرجع الدفع MOEEN-<code>-...
  billingCode   Int          @unique @default(autoincrement())
  // رصيد المحفظة المسبقة — لا يهبط تحت الصفر أبداً (القسم 24.8.5)
  walletBalance Decimal      @default(0) @db.Decimal(12, 2)
  // نهاية الفترة المدفوعة الحالية (للباقات المدفوعة)
  currentPeriodEnd DateTime?
  // مرحلة الإنذار الحالية لتفادي تكرار الرسائل (0=لا شيء، 1=يوم7، 2=يوم10، 3=معلّق، 4=إنذار نهائي)
  dunningStage  Int          @default(0)
  // تأكيد طلبات COD هاتفياً قبل التجهيز — القسم 7.1 (مفعّل افتراضياً)
  codConfirmation Boolean    @default(true)
  shippingFee   Decimal      @default(0) @db.Decimal(12, 2)
  // توصيل مجاني فوق مبلغ — أداة تسويقية (القسم 8.2)
  freeShippingAbove Decimal? @db.Decimal(12, 2)
  // ---- تخصيص مظهر المتجر (القسم 5.4): هوية بصرية لكل تاجر ----
  // لون المتجر الأساسي (hex) — يطغى على لون المنصة في واجهة المتجر
  themeColor    String?
  // صورة غلاف أعلى المتجر
  coverUrl      String?
  // بنرات ترويجية [{imageUrl, link?}] حتى 5
  banners       Json         @default("[]")
  // صفحات المتجر: من نحن + سياسة الاستبدال والإرجاع
  aboutText     String?
  returnPolicy  String?
  // روابط التواصل {instagram, facebook, tiktok, x}
  socialLinks   Json         @default("{}")
  owner         User         @relation(fields: [ownerId], references: [id])
  ownerId       String
  governorate   Governorate? @relation(fields: [governorateId], references: [id])
  governorateId Int?
  city          String?
  createdAt     DateTime     @default(now())
  products      Product[]
  orders        Order[]
  categories    Category[]
  coupons       Coupon[]
  shippingRates ShippingRate[]
  notifications Notification[]
  invoices      Invoice[]
  walletTxns    WalletTransaction[]
  // مستوى التوثيق (القسم 4.3): 0 مسجّل، 1 هوية موثّقة، 2 نشاط موثّق
  kycLevel      Int          @default(0)
  suspensionReason String?
  kycSubmissions KycSubmission[]
  reviews       Review[]
  disputes      Dispute[]
  abandonedCarts AbandonedCart[]
}

// ---------- توثيق التاجر KYC (القسم 4.3) ----------

model KycSubmission {
  id         String    @id @default(cuid())
  store      Store     @relation(fields: [storeId], references: [id])
  storeId    String
  level      Int // المستوى المطلوب: 1 أو 2
  idImageUrl String // صورة الهوية/الجواز
  selfieUrl  String? // سيلفي مطابقة (مستوى 1)
  proofUrl   String? // سجل تجاري / إثبات نشاط (مستوى 2)
  note       String? // ملاحظة التاجر
  status     KycStatus @default(PENDING)
  adminNote  String? // سبب الرفض المحدد — يصل التاجر (القسم 4.3)
  reviewedBy String?
  reviewedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([status, createdAt])
}

enum KycStatus {
  PENDING
  APPROVED
  REJECTED
}

// ---------- التقييمات (القسم 13) — بعد التسليم الفعلي فقط ----------

model Review {
  id           String       @id @default(cuid())
  store        Store        @relation(fields: [storeId], references: [id])
  storeId      String
  orderId      String       @unique // تقييم واحد لكل طلب مُسلَّم
  customerName String
  rating       Int // 1-5
  comment      String?
  imageUrl     String? // صورة المنتج بعد الاستلام (القسم 25.3)
  reply        String? // رد التاجر العلني
  status       ReviewStatus @default(VISIBLE)
  createdAt    DateTime     @default(now())

  @@index([storeId, status, createdAt])
}

enum ReviewStatus {
  VISIBLE
  REPORTED // بلّغ التاجر — تحكم فيه الإدارة
  HIDDEN // أخفته الإدارة
}

// ---------- النزاعات (القسمان 14.3 و25.2) ----------

model Dispute {
  id         String        @id @default(cuid())
  store      Store         @relation(fields: [storeId], references: [id])
  storeId    String
  orderId    String        @unique
  reason     String
  status     DisputeStatus @default(OPEN)
  resolution String? // قرار الإدارة الموثق
  resolvedBy String?
  createdAt  DateTime      @default(now())
  resolvedAt DateTime?

  @@index([status, createdAt])
}

enum DisputeStatus {
  OPEN
  RESOLVED // لصالح العميل
  REJECTED // لصالح التاجر
}

// ---------- السلة المهجورة (القسم 9.2) ----------

model AbandonedCart {
  id         String    @id @default(cuid())
  store      Store     @relation(fields: [storeId], references: [id])
  storeId    String
  phone      String
  items      Json
  notifiedAt DateTime? // رسالة واحدة فقط — لا إزعاج
  createdAt  DateTime  @default(now())

  @@unique([storeId, phone])
}

// ---------- الفوترة وتحصيل الاشتراك (القسم 24 بالملحق) ----------

// فاتورة اشتراك — لكل فاتورة مرجع فريد عالمياً MOEEN-<كود التاجر>-<سنةشهر>
model Invoice {
  id          String        @id @default(cuid())
  store       Store         @relation(fields: [storeId], references: [id])
  storeId     String
  reference   String        @unique
  plan        Plan
  months      Int           @default(1)
  amount      Decimal       @db.Decimal(12, 2)
  currency    Currency      @default(YER_SANAA)
  status      InvoiceStatus @default(PENDING)
  periodStart DateTime
  periodEnd   DateTime
  paidAt      DateTime?
  paidVia     String? // WALLET / AGGREGATOR / MEPS / MANUAL ...
  createdAt   DateTime      @default(now())
  events      PaymentEvent[]

  @@index([storeId, status])
}

enum InvoiceStatus {
  PENDING
  PAID
  CANCELLED
}

// حدث دفع وارد — كل المصادر تدخل طابور ابتلاع واحد (القسم 24.1)
// idempotent: (المصدر + المعرف الخارجي) فريد — تكرار الإشعار لا يفعّل مرتين
model PaymentEvent {
  id               String             @id @default(cuid())
  source           PaymentSource
  externalId       String
  reference        String?
  amount           Decimal            @db.Decimal(12, 2)
  currency         Currency           @default(YER_SANAA)
  status           PaymentEventStatus @default(RECEIVED)
  error            String?
  matchedInvoice   Invoice?           @relation(fields: [matchedInvoiceId], references: [id])
  matchedInvoiceId String?
  payload          Json?
  createdAt        DateTime           @default(now())
  processedAt      DateTime?

  @@unique([source, externalId])
  @@index([status])
}

enum PaymentSource {
  AGGREGATOR // eSadad / WeNet — المسار 2 (العمود الفقري)
  MEPS // خصم من التسوية / بطاقة — المساران 1 و4
  WALLET_RTP // طلب دفع من محفظة مباشرة — المسار 3
  BANK_FEED // حوالة بمطابقة آلية — المسار 5
  MANUAL // إيصال يدوي — المسار 6 (آخر حل)
}

enum PaymentEventStatus {
  RECEIVED // وصل ولم يُعالج بعد
  MATCHED // طُوبق وفُعّل آلياً
  DUPLICATE // تكرار — تجوهل بأمان
  EXCEPTION // غامض — طابور الاستثناءات للمراجعة البشرية (الهدف < 5%)
}

// دفتر أستاذ المحفظة — append-only: لا تعديل ولا حذف، فقط قيود (القسم 24.8)
model WalletTransaction {
  id             String     @id @default(cuid())
  store          Store      @relation(fields: [storeId], references: [id])
  storeId        String
  type           WalletTxnType
  // موجب = إيداع، سالب = خصم
  amount         Decimal    @db.Decimal(12, 2)
  balanceAfter   Decimal    @db.Decimal(12, 2)
  idempotencyKey String?    @unique
  note           String?
  invoiceId      String?
  eventId        String?
  createdAt      DateTime   @default(now())

  @@index([storeId, createdAt])
}

enum WalletTxnType {
  TOPUP // شحن رصيد
  CHARGE // خصم اشتراك
  CREDIT // فائض دفع يُقيَّد للمحفظة
  ADJUSTMENT // تسوية إدارية (بقيد موثّق)
}

// تصنيفات المنتجات لكل متجر (القسم 5.4)
model Category {
  id        String    @id @default(cuid())
  store     Store     @relation(fields: [storeId], references: [id])
  storeId   String
  name      String
  sortOrder Int       @default(0)
  products  Product[]

  @@unique([storeId, name])
}

// أسعار الشحن لكل محافظة (القسم 8.2) — والافتراضي Store.shippingFee
model ShippingRate {
  id            String      @id @default(cuid())
  store         Store       @relation(fields: [storeId], references: [id])
  storeId       String
  governorate   Governorate @relation(fields: [governorateId], references: [id])
  governorateId Int
  fee           Decimal     @db.Decimal(12, 2)
  // مدة توصيل متوقعة تظهر للعميل — شفافية (القسم 25.3 بالملحق)
  etaText       String?

  @@unique([storeId, governorateId])
}

// الكوبونات (القسم 9.1)
model Coupon {
  id        String     @id @default(cuid())
  store     Store      @relation(fields: [storeId], references: [id])
  storeId   String
  code      String
  type      CouponType
  value     Decimal    @db.Decimal(12, 2)
  minOrder  Decimal?   @db.Decimal(12, 2)
  maxUses   Int?
  usedCount Int        @default(0)
  expiresAt DateTime?
  active    Boolean    @default(true)
  createdAt DateTime   @default(now())

  @@unique([storeId, code])
}

enum CouponType {
  PERCENT
  FIXED
}

// سجل الإشعارات — كل رسالة (واتساب الآن، SMS احتياطاً لاحقاً) تمر عبر
// طابور BullMQ بإعادة محاولة (القسم 22.3.2 بالملحق) وتُسجَّل هنا للتدقيق
model Notification {
  id        String             @id @default(cuid())
  store     Store?             @relation(fields: [storeId], references: [id])
  storeId   String?
  orderId   String?
  channel   String             @default("WHATSAPP")
  recipient String
  template  String
  body      String
  status    NotificationStatus @default(PENDING)
  attempts  Int                @default(0)
  lastError String?
  sentAt    DateTime?
  createdAt DateTime           @default(now())

  @@index([storeId, createdAt])
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
}

enum StoreStatus {
  ACTIVE
  SUSPENDED // تعليق لعدم السداد (القسم 24.5 بالملحق) أو مخالفة
  CLOSED
}

enum Plan {
  FREE // بداية
  GROWTH // نمو
  PRO // احتراف
}

enum Currency {
  YER_SANAA
  YER_ADEN
  USD
  SAR
}

// ---------- المنتجات (القسم 5) ----------

model Product {
  id             String        @id @default(cuid())
  store          Store         @relation(fields: [storeId], references: [id])
  storeId        String
  category       Category?     @relation(fields: [categoryId], references: [id])
  categoryId     String?
  name           String
  description    String?
  price          Decimal       @db.Decimal(12, 2)
  compareAtPrice Decimal?      @db.Decimal(12, 2) // سعر قبل التخفيض
  imageUrl       String?
  // صور إضافية (القسم 5.2: حتى 10 صور) — روابط مرتبة
  images         Json          @default("[]")
  trackStock     Boolean       @default(false)
  stock          Int           @default(0)
  // منتج مميز — يتصدّر واجهة المتجر بشارة (القسم 5.4)
  featured       Boolean       @default(false)
  status         ProductStatus @default(ACTIVE)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  orderItems     OrderItem[]
  variants       ProductVariant[]

  @@index([storeId, status])
}

// خيارات المنتج (القسم 5.1): "أحمر / L" بسعر ومخزون مستقلين
model ProductVariant {
  id        String      @id @default(cuid())
  product   Product     @relation(fields: [productId], references: [id])
  productId String
  name      String
  price     Decimal?    @db.Decimal(12, 2) // فارغ = سعر المنتج الأساسي
  stock     Int         @default(0)
  sortOrder Int         @default(0)
  orderItems OrderItem[]

  @@unique([productId, name])
}

enum ProductStatus {
  ACTIVE
  HIDDEN
}

// ---------- الطلبات (القسم 7) ----------

model Order {
  id             String        @id @default(cuid())
  // كود تتبع عام قصير يظهر للعميل — صفحة تتبع بدون تسجيل دخول (القسم 6.3)
  code           String        @unique
  store          Store         @relation(fields: [storeId], references: [id])
  storeId        String
  // مفتاح idempotency يمنع تكرار الطلب عند إعادة الإرسال offline — القسم 22.1.2 بالملحق
  idempotencyKey String?
  customerName   String
  customerPhone  String
  // العنوان اليمني — القسم 23.2 بالملحق: محافظة + مديرية + حي/عزلة + وصف تفصيلي
  governorate    Governorate   @relation(fields: [governorateId], references: [id])
  governorateId  Int
  district       District?     @relation(fields: [districtId], references: [id])
  districtId     Int?
  districtText   String? // للمحافظات التي لم تُحمَّل مديرياتها بعد
  neighborhood   String // الحي / العزلة / المنطقة
  addressDetails String // الوصف التفصيلي: "بجانب مسجد كذا..."
  courierNote    String? // ملاحظة للمندوب
  paymentMethod  PaymentMethod @default(COD)
  status         OrderStatus   @default(NEW)
  subtotal       Decimal       @db.Decimal(12, 2)
  shippingFee    Decimal       @default(0) @db.Decimal(12, 2)
  couponCode     String?
  discount       Decimal       @default(0) @db.Decimal(12, 2)
  total          Decimal       @db.Decimal(12, 2)
  currency       Currency
  items          OrderItem[]
  events         OrderEvent[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@unique([storeId, idempotencyKey])
  @@index([storeId, status, createdAt])
}

model OrderItem {
  id        String   @id @default(cuid())
  order     Order    @relation(fields: [orderId], references: [id])
  orderId   String
  product   Product? @relation(fields: [productId], references: [id])
  productId String?
  variant   ProductVariant? @relation(fields: [variantId], references: [id])
  variantId String?
  name      String // لقطة من اسم المنتج (+ الخيار) وقت الطلب
  price     Decimal  @db.Decimal(12, 2)
  quantity  Int
}

// سجل أحداث الطلب — كل تغيير حالة يُسجَّل (وأساس إشعارات واتساب لاحقاً)
model OrderEvent {
  id        String      @id @default(cuid())
  order     Order       @relation(fields: [orderId], references: [id])
  orderId   String
  status    OrderStatus
  note      String?
  createdAt DateTime    @default(now())
}

enum OrderStatus {
  NEW // جديد — قيد المراجعة
  PROCESSING // قيد التجهيز
  OUT_FOR_DELIVERY // مع المندوب
  DELIVERED // تم التسليم
  CANCELLED // ملغي
  RETURNED // مرتجع
}

enum PaymentMethod {
  COD // الدفع عند الاستلام — الافتراضي والوحيد في المرحلة 1
}
