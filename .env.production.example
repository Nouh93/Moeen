# انسخ إلى .env بجانب docker-compose.prod.yml واملأ القيم — كلها إلزامية
# كلمة سر قاعدة البيانات (ولّدها: openssl rand -hex 24)
DB_PASSWORD=
# سر توقيع الجلسات (openssl rand -hex 32)
JWT_SECRET=
# سر توقيع webhooks الدفع — يُعطى للمُجمِّع/البنك (openssl rand -hex 32)
PAYMENTS_WEBHOOK_SECRET=
# رابط الواجهة العام — يُستخدم في رسائل واتساب
WEB_URL=https://moeen.ye
# رابط الـ API العام كما يراه المتصفح (خلف الـ reverse proxy)
API_PUBLIC_URL=https://api.moeen.ye
